# ── 密钥与环境 ─────────────────────────────────────────
.env
.env.*
!.env.example
*.key
*.pem
secrets.*

# ── 运行时产物（含真实消息，绝对不能提交）─────────────
var/
output/
*.db
*.sqlite
*.sqlite3
*.log
demo_out.txt

# 审计日志：里面有会话 id 与判定记录
var/audit/

# ── 浏览器登录态（泄露等于把账号交出去）────────────────
cookies*
*_cookie.json
storage_state*.json
auth/*.json
dsh-profile/
.user-data/
edge-profile/
browser_profile/

# ── 截图里的原图（先脱敏再放进 docs/screenshots）──────
docs/screenshots/raw/
docs/screenshots/*.jpg
docs/screenshots/*.jpeg

# ── Python ─────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/
*.egg-info/

# ── Node（如果你用 DSH CLI 装插件）────────────────────
node_modules/
npm-debug.log*
pnpm-debug.log*
yarn-error.log*
.pnpm-store/

# ── 编辑器与系统 ───────────────────────────────────────
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ── 本地工作区 ─────────────────────────────────────────
.workbuddy/
