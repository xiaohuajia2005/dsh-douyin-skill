# 复制成 .env 后填写。.env 已在 .gitignore 里，不会进仓库。
# 本项目跑 demo / selftest 不需要任何密钥；只有接真实模型时才要。

# ── DeepSeek ───────────────────────────────────────────
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 只能用 v4 系列。
# deepseek-chat / deepseek-reasoner 已于 2026-07-24 弃用，填了会直接报错。
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_MODEL_FALLBACK=deepseek-v4-pro

# ── 插件侧（在 DSH 设置页里填，不用写这里）──────────────
# 主模型、人格卡、额度都在 DSH 界面配置，这个文件只管密钥。
# 额度阈值请以 config/skill.toml 为准，两边要人工对齐。
